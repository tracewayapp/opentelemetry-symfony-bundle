{
    "name": "traceway/opentelemetry-symfony-e2e",
    "description": "End-to-end harness: real kernel, real OTLP export, real collector.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.3",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "traceway/opentelemetry-symfony": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Traceway\\OpenTelemetryBundle\\E2E\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
