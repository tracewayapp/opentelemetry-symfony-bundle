<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/symfony/phpunit-bridge/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <php>
        <!--
            Bridge-controlled deprecation tracking.

            max[self]=0  → unlimited self-deprecations are allowed only inside
                           tests marked #[Group('legacy')]; any other test
                           triggering a self-deprecation fails the suite.
            ignoreFile=  → no allowlist file; rely on @group legacy + explicit
                           expectUserDeprecationMessage() calls.
        -->
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[self]=0"/>
        <!-- Unset so the SDK's ComposerHandler guard doesn't no-op _autoload.php under `composer test`. -->
        <env name="COMPOSER_DEV_MODE" value="" force="true"/>
    </php>

    <testsuites>
        <testsuite name="OpenTelemetry Symfony Bundle">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
